# References into the Proton Pass "CLI" vault, resolved by `secrets <command>`.
# Pointers only, no values: safe to commit.
STRIPE_API_KEY=pass://CLI/Stripe/api_key
STRIPE_WEBHOOK_SECRET=pass://CLI/Stripe/webhook_secret
SCW_SECRET_KEY=pass://CLI/Scaleway/secret_key
DOKPLOY_API_KEY=pass://CLI/Dokploy/api_key
DOKPLOY_URL=pass://CLI/Dokploy/url
